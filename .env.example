# The Laravel API of the store (the storefront endpoints). Used at BUILD time (the pages are baked from it) and in the browser (price, stock, cart, checkout).
# Local:      http://127.0.0.1:8002/api/v1/store
# Production: https://api.example.com/api/v1/store
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8002/api/v1/store

# The public address of THIS website (canonical links, Open Graph, sitemap.xml, robots.txt). No trailing slash.
# Local: http://localhost:3000     Production: https://www.example.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Pages: also set NODE_VERSION=22 (or 24) in the project's environment variables.
