# Cloudflare Pages / Netlify headers (ignored by hosts that do not know the file; the cPanel variant is public/.htaccess.example)

# Hashed build files never change: cache them for a year
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts and the pictures that ship with the site
/_fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=2592000

# HTML and the payload files: always check with the server (a rebuild replaces them)
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Pages that must not be indexed or cached
/cart
  X-Robots-Tag: noindex
/checkout
  X-Robots-Tag: noindex
/track
  X-Robots-Tag: noindex
/order/*
  X-Robots-Tag: noindex

# The version file that the admin panel reads: not a page
/build.json
  X-Robots-Tag: noindex
  Cache-Control: no-store
